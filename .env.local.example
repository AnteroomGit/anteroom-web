# Copy this file to .env.local (same folder) and fill in your real values.
# .env.local is already gitignored, so real credentials never get pushed
# to GitHub.

NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Server-side only — get this from console.anthropic.com. Unlike the two
# Supabase values above, this one must NEVER be prefixed with NEXT_PUBLIC_,
# and in Vercel it must be added as type "Secret", not "Config" — this key
# should never reach the browser.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Get this from dash.cloudflare.com -> Turnstile (free). Unlike the
# Anthropic key, this one IS meant to be public — add it in Vercel as
# type "Config", same as the two Supabase values.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

# Get this from the same Cloudflare Turnstile page as the site key above.
# This one is server-side only, like the Anthropic key. In Vercel, add
# it as type "Secret", not "Config". It must never reach the browser.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here

# Xero: register a free app yourself at developer.xero.com/app/manage --
# self-serve, no approval wait. Both values come from that app. Server-side
# only, like the Turnstile secret above.
XERO_CLIENT_ID=your-xero-client-id-here
XERO_CLIENT_SECRET=your-xero-client-secret-here
# Must exactly match the redirect URI you register in the Xero app --
# including https:// and no trailing slash.
XERO_REDIRECT_URI=https://anteroom.com.au/api/integrations/xero/callback

# MYOB: register an app at my.myob.com -- unlike Xero, this needs MYOB's
# manual approval into their Developer Program before you can even create
# an app, so this one has real lead time, not a same-day turnaround.
MYOB_CLIENT_ID=your-myob-api-key-here
MYOB_CLIENT_SECRET=your-myob-secret-here
MYOB_REDIRECT_URI=https://anteroom.com.au/api/integrations/myob/callback

# Manager.io needs no app registration and no keys here at all -- each
# client pastes in their own per-business API key (generated inside their
# own Manager.io account) directly through the Connect Manager.io form in
# their account settings. Nothing to add to this file for it.

# Used by the Xero/MYOB OAuth callback routes and the financial-report
# generator to write data attached to a specific client without an active
# browser session to authenticate as (see the comments in
# app/api/integrations/xero/callback/route.js for exactly why). Already
# present in your Vercel env vars from the Supabase integration -- find it
# under SUPABASE_SERVICE_ROLE_KEY there and copy the same value here.
# This key bypasses every RLS policy in the database: never expose it to
# the browser, and never add NEXT_PUBLIC_ in front of it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
